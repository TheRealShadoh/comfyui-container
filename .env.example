# ComfyUI Container Configuration

# Update ComfyUI on container start (true/false)
UPDATE_ON_START=true

# CUDA device to use (0 = first GPU, 1 = second GPU, etc.)
CUDA_VISIBLE_DEVICES=0

# Memory limit for container (in GB)
MEMORY_LIMIT=16

# Python output buffering (set to 1 to see logs in real-time)
PYTHONUNBUFFERED=1

# Enable GPU visibility
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
